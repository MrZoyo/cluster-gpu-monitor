# Optional anonymous summary, Caddy 2.6+; import this file at top level.
# Inside the site: import gpumon_summary_access, attach @gpumon_private to
# basic_auth (basicauth before 2.8), and replace reverse_proxy with
# import gpumon_summary_proxy. See docs/API.md.
(gpumon_summary_access) {
    @gpumon_private {
        not {
            method GET
            path /api/v1/gpu-summary
        }
    }
}

(gpumon_summary_proxy) {
    route {
        # Always overwrite a caller-supplied header with the TCP peer address.
        request_header X-Gpumon-Client-IP {remote_host}
        # Cloudflare public ranges, verified 2026-09-08:
        # https://www.cloudflare.com/ips-v4/ and https://www.cloudflare.com/ips-v6/
        @gpumon_cloudflare remote_ip 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
        request_header @gpumon_cloudflare X-Gpumon-Client-IP {http.request.header.CF-Connecting-IP}
        reverse_proxy 127.0.0.1:8848 {
            # Give Uvicorn one canonical client IP, not an untrusted XFF chain.
            header_up X-Forwarded-For {http.request.header.X-Gpumon-Client-IP}
            header_up -X-Gpumon-Client-IP
        }
    }
}
