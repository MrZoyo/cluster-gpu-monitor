[Unit]
Description=gpumon web (system 级，仅监听 127.0.0.1，对外经 Caddy)
After=network-online.target

[Service]
Type=simple
User=__USER__
WorkingDirectory=__ROOT__/current
Environment=GPUMON_ROOT=__ROOT__
ExecStart=__ROOT__/current/.venv/bin/gpumon web
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
